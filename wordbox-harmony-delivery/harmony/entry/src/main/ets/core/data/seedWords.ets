/** Build the immutable 240-word seed library. */
function buildSeedWords(): readonly Word[] {
  const words: Word[] = [];
  for (const scene of ALL_SCENES) {
    const tuples: readonly SeedTuple[] = SEED_DATA[scene];
    const role: string = SCENE_AI_ROLES[scene];
    for (const tuple of tuples) {
      const word: Word = {
        id: wordIdOf(tuple[0], scene, WordSource.Seed),
        text: tuple[0],
        phonetic: tuple[1],
        meaningZh: tuple[2],
        scene: scene,
        locale: 'en-US',
        exampleInScene: tuple[3],
        aiRolePrompt: 'You are a ' + role + '; use this phrase naturally in a real travel conversation.',
        source: WordSource.Seed,
        createdAtYMD: '',
      };
      words.push(word);
    }
  }
  return words;
}

/** Exactly 240 built-in words, ordered by ALL_SCENES then by authoring order. */
export const SEED_WORDS: readonly Word[] = buildSeedWords();

/** Seed words of one scene (exactly 30). */
export function seedWordsOf(scene: Scene): readonly Word[] {
  const out: Word[] = [];
  for (const word of SEED_WORDS) {
    if (word.scene === scene) out.push(word);
  }
  return out;
}
